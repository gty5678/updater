{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure updater (Windows)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "windows-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build updater (Windows)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "windows-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure updater (Windows)",
      "problemMatcher": [
        "$msCompile"
      ],
      "group": "build"
    },
    {
      "label": "Configure updater (macOS)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "macos-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build updater (macOS)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "macos-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure updater (macOS)",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Configure updater (Linux)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build updater (Linux)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure updater (Linux)",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    }
  ]
}
